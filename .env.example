# ============================================================
# OpenClaw Docker Compose Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ============================================================
# Docker Image
# ============================================================
# Docker image name (default: openclaw:local)
OPENCLAW_IMAGE=openclaw:local

# ============================================================
# Gateway Configuration (Required)
# ============================================================
# Gateway authentication token (generate with: openssl rand -hex 32)
OPENCLAW_GATEWAY_TOKEN=your-secure-token-here

# Config directory (contains openclaw.json)
OPENCLAW_CONFIG_DIR=/path/to/.openclaw

# Workspace directory (agent file operations root)
OPENCLAW_WORKSPACE_DIR=/path/to/.openclaw/workspace

# Network binding mode:
#   loopback = only localhost (127.0.0.1)
#   lan = all interfaces (0.0.0.0)
OPENCLAW_GATEWAY_BIND=lan

# ============================================================
# Model Provider API Keys
# ============================================================
# IMPORTANT: When using custom OpenAI-compatible providers (like ZetaTechs),
# you must configure models.providers in openclaw.json with baseUrl.
# The OPENAI_BASE_URL environment variable is NOT automatically used
# by OpenClaw's built-in OpenAI provider.
#
# Example openclaw.json for custom provider:
# {
#   "models": {
#     "providers": {
#       "my-provider": {
#         "baseUrl": "https://api.example.com/v1",
#         "apiKey": "${OPENAI_API_KEY}",
#         "api": "openai-completions",
#         "models": [{ "id": "gpt-4o", "name": "GPT-4o" }]
#       }
#     }
#   }
# }

# OpenAI-compatible API key (used by custom providers via ${OPENAI_API_KEY})
# OPENAI_API_KEY=sk-your-api-key-here

# OpenAI-compatible API base URL (for reference only, configure in openclaw.json)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic API key (if using Anthropic models)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API key (if using Gemini models)
# GEMINI_API_KEY=your-gemini-key-here

# OpenRouter API key (if using OpenRouter)
# OPENROUTER_API_KEY=sk-or-your-key-here

# ============================================================
# Web Search Configuration
# ============================================================
# Bocha Search API key (for web_search tool with provider: "bocha")
# Get your key at: https://bocha.cn
# BOCHA_API_KEY=sk-your-bocha-key-here

# Brave Search API key (for web_search tool with provider: "brave")
# Get your key at: https://brave.com/search/api/
# BRAVE_API_KEY=your-brave-key-here

# Perplexity API key (for web_search tool with provider: "perplexity")
# PERPLEXITY_API_KEY=pplx-your-key-here

# ============================================================
# Twilio WhatsApp (optional)
# ============================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Must be a WhatsApp-enabled Twilio number, prefixed with whatsapp:
TWILIO_WHATSAPP_FROM=whatsapp:+1234567890

# ============================================================
# TTS / Voice (optional)
# ============================================================
# ElevenLabs API key for text-to-speech
# ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ============================================================
# Claude Web Provider (optional)
# ============================================================
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
